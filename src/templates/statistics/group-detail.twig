{% extends 'lindemannrock-base/_layouts/cp-table' %}

{% set detailParams = {
    dateRange: dateRange,
    groupBy: groupBy,
    siteId: siteId,
} %}
{% if fieldHandle %}
    {% set detailParams = detailParams|merge({fieldHandle: fieldHandle}) %}
{% endif %}

{% set formParams = {
    dateRange: dateRange,
    groupBy: groupBy,
    siteId: siteId,
} %}
{% set detailHeading = 'Individual Submissions for {value}'|t('formie-rating-field', {value: groupValue})|e %}
{% set detailSummary = 'Showing {count} submission(s) for this {groupBy}'|t('formie-rating-field', {count: totalSubmissions, groupBy: groupByLabel})|e %}

{% set columns = [
    {key: 'dateCreated', label: 'Date'|t('formie-rating-field'), nowrap: true},
    {key: 'submission', label: 'Submission'|t('formie-rating-field')},
] %}
{% for formField in form.getFields() %}
    {% if formField.handle != groupBy %}
        {% set columns = columns|merge([{
            key: formField.handle,
            label: formField.label,
        }]) %}
    {% endif %}
{% endfor %}

{% set tableConfig = {
    plugin: {
        handle: 'formie-rating-field',
        name: ratingHelper.fullName,
    },
    page: {
        title: '{value} - Individual Submissions'|t('formie-rating-field', {value: groupValue})|e,
        subnav: 'statistics',
        url: url('formie-rating-field/statistics/form/' ~ form.id ~ '/group/' ~ (groupValue|url_encode)),
        crumbs: [
            {
                label: ratingHelper.fullName,
                url: url('formie-rating-field'),
            },
            {
                label: 'Statistics'|t('formie-rating-field'),
                url: url('formie-rating-field/statistics'),
            },
            {
                label: form.title,
                url: url('formie-rating-field/statistics/form/' ~ form.id, formParams) ~ (fieldHandle ? '#' ~ fieldHandle : ''),
            },
            {
                label: groupValue,
                url: url('formie-rating-field/statistics/form/' ~ form.id ~ '/group/' ~ (groupValue|url_encode), detailParams),
            },
        ],
    },
    preserveParams: detailParams,
    table: {
        columns: columns,
        items: submissions,
        emptyMessage: 'No submissions found for this {groupBy}'|t('formie-rating-field', {groupBy: groupByLabel}),
    },
    pagination: {
        page: page,
        limit: limit,
        totalCount: totalSubmissions,
        itemLabel: {
            singular: 'Submission'|t('formie-rating-field'),
            plural: 'Submissions'|t('formie-rating-field'),
        },
    },
    checkboxes: false,
    rowActions: false,
} %}

{% block toolbar %}{% endblock %}

{% block pageTitle %}
    <div>
        <h1 id="page-heading" class="screen-title mb-0" title="{{ detailHeading }}">
            {{ detailHeading }}
        </h1>
        <p class="light mt-2xs mb-0">{{ detailSummary }}</p>
    </div>
    <div id="revision-indicators"></div>
{% endblock %}

{% block actionButton %}
    {% if currentUser.can('formieRatingField:exportStatistics') %}
        <div id="action-button">
            {% include 'lindemannrock-base/_components/export-menu' with {
                action: 'formie-rating-field/statistics/export-group',
                pluginHandle: 'formie-rating-field',
                extraParams: {
                    formId: form.id,
                    groupBy: groupBy,
                    groupValue: groupValue,
                    dateRange: dateRange,
                    siteId: siteId,
                },
            } only %}
        </div>
    {% endif %}
{% endblock %}

{% block tableRow %}
    <td class="nowrap">{{ item.dateCreated|lrDatetime }}</td>
    <td>
        <a href="{{ item.cpEditUrl }}" target="_blank" class="go">
            <code>{{ item.id }}</code>
        </a>
    </td>
    {% for formField in form.getFields() %}
        {% if formField.handle != groupBy %}
            {% set value = item.getFieldValue(formField.handle) %}
            {% set displayValue = formField.getValueAsString(value, item) %}
            <td>
                {% if displayValue is not null and displayValue is not same as('') %}
                    {{ displayValue|length > 100 ? displayValue|slice(0, 100) ~ '...' : displayValue }}
                {% else %}
                    —
                {% endif %}
            </td>
        {% endif %}
    {% endfor %}
{% endblock %}
